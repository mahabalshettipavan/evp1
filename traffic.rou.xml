<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="50" guiShape="passenger"/>
    
    <vType id="ambulance" accel="3.5" decel="4.5" length="6" minGap="2.5" maxSpeed="70" color="255,0,0" guiShape="ambulance" vClass="emergency">
        <param key="has.bluelight.device" value="true"/>
    </vType>

    <vType id="firetruck" accel="2.0" decel="4.0" length="10" minGap="3.0" maxSpeed="45" color="255,100,0" guiShape="firebrigade" vClass="emergency"/>

    <route id="route_NS" edges="N2C C2S"/>
    <route id="route_WE" edges="W2C C2E"/>
    <route id="route_EW" edges="E2C C2W"/>
    <route id="route_SN" edges="S2C C2N"/>

    <flow id="f_cars_NS" type="car" begin="0" end="1000" number="80" route="route_NS" departPos="last"/>
    <flow id="f_cars_WE" type="car" begin="0" end="1000" number="80" route="route_WE" departPos="last"/>
    <flow id="f_cars_EW" type="car" begin="0" end="1000" number="80" route="route_EW" departPos="last"/>
    <flow id="f_cars_SN" type="car" begin="0" end="1000" number="80" route="route_SN" departPos="last"/>

    <vehicle id="amb_1" type="ambulance" route="route_EW" depart="50" />
    <vehicle id="fire_1" type="firetruck" route="route_NS" depart="120" />
    <vehicle id="amb_2" type="ambulance" route="route_WE" depart="200" />
</routes>